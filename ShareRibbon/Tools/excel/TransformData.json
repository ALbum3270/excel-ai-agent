{
  "id": "TransformData",
  "name": "数据转换",
  "description": "对 Excel 范围执行转置、拆分列、合并列等结构转换",
  "appType": "excel",
  "category": "数据操作",
  "riskLevel": "medium",
  "isVbaFallback": false,
  "parameters": [
    {
      "name": "sourceRange",
      "type": "string",
      "required": true,
      "description": "源数据范围，如 A1:D20 或 {selection}"
    },
    {
      "name": "operation",
      "type": "string",
      "required": true,
      "description": "转换操作：transpose/split/merge"
    },
    {
      "name": "targetRange",
      "type": "string",
      "required": false,
      "description": "输出目标左上角单元格，transpose/merge 推荐填写"
    },
    {
      "name": "delimiter",
      "type": "string",
      "required": false,
      "description": "split/merge 使用的分隔符"
    }
  ]
}
