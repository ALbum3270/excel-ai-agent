{
  "id": "official-document",
  "name": "党政机关公文",
  "description": "GB/T 9704-2012 党政机关公文格式规范",
  "triggerKeywords": ["公文", "GB/T 9704", "国标", "党政", "发文", "通知", "函", "请示", "报告", "批复"],

  "identificationPatterns": {
    "发文机关标志": {
      "position": "文档开头1-3段",
      "patterns": [
        ".*政府.*",
        ".*办公厅.*",
        ".*委员会.*",
        ".*人民代表大会.*",
        ".*人大常委会.*"
      ],
      "features": ["通常为机关全称", "可能包含徽标", "字数较少（<30字）", "无标点或仅有空格"]
    },
    "发文字号": {
      "position": "发文机关标志之后",
      "patterns": [
        ".*〔\\d{4}〕\\d+号",
        ".*\\[\\d{4}\\]\\d+号",
        ".*（\\d{4}）第?\\d+号",
        ".*发\\[\\d{4}\\]\\d+号"
      ],
      "features": ["包含年份（4位数字）", "包含序号", "包含「号」字", "长度<30字"],
      "examples": ["国办发〔2024〕1号", "X政办〔2023〕15号", "X委发[2024]3号"]
    },
    "签发人": {
      "position": "发文字号同行或下一行",
      "patterns": ["签发人[:：].*", "签发[:：].*"],
      "features": ["包含「签发人」或「签发」", "后跟人名", "一般在右侧"],
      "examples": ["签发人：张三", "签发：李四"]
    },
    "标题": {
      "position": "发文字号之后、主送机关之前",
      "patterns": [
        "关于.*的通知",
        "关于.*的函",
        "关于.*的请示",
        "关于.*的报告",
        "关于.*的批复",
        ".*通知$",
        ".*函$",
        ".*请示$"
      ],
      "features": ["通常包含「关于」", "以文种结尾（通知、函、请示等）", "字数10-50字", "可能换行"],
      "examples": ["关于印发XX实施方案的通知", "关于申请XX经费的请示"]
    },
    "主送机关": {
      "position": "标题之后、正文之前",
      "patterns": [
        ".*政府[：:]",
        ".*办公厅[：:]",
        ".*委员会[：:]",
        ".*厅局[：:]",
        "各.*[：:]"
      ],
      "features": ["以冒号结尾", "包含机关名称", "可能有「各」字", "顶格不缩进"],
      "examples": ["各市、县人民政府：", "省直各单位：", "XX厅、XX局："]
    },
    "正文首段": {
      "position": "主送机关之后",
      "patterns": ["经.*同意", "根据.*要求", "为.*", "现将.*"],
      "features": ["首行缩进2字符", "通常包含「经...同意」「根据...」「为...」「现将...」"],
      "examples": ["经省政府同意，现将...", "根据国务院要求，现就..."]
    },
    "正文结构标题_一级": {
      "patterns": ["^[一二三四五六七八九十]+、.*", "^第[一二三四五六七八九十]+章.*"],
      "features": ["以汉字数字开头", "后跟顿号或「章」", "通常单独成段", "字数<20"],
      "examples": ["一、工作目标", "二、主要任务", "第一章 总则"]
    },
    "正文结构标题_二级": {
      "patterns": ["^（[一二三四五六七八九十]+）.*", "^\\([一二三四五六七八九十]+\\).*"],
      "features": ["括号包裹汉字数字", "可能有缩进", "字数<20"],
      "examples": ["（一）加强组织领导", "（二）完善工作机制"]
    },
    "正文结构标题_三级": {
      "patterns": ["^\\d+\\.", "^\\d+\\.\\s.*"],
      "features": ["以阿拉伯数字开头", "后跟点号", "可能有缩进"],
      "examples": ["1.明确责任分工", "2.强化监督检查"]
    },
    "附件说明": {
      "position": "正文之后、成文日期之前",
      "patterns": ["^附件[:：].*", "^附件\\d+[:：].*"],
      "features": ["以「附件」开头", "后跟冒号", "可能有编号"],
      "examples": ["附件：XX实施方案", "附件1：名单", "附件2：表格"]
    },
    "发文机关署名": {
      "position": "正文之后、成文日期之上",
      "patterns": [".*政府$", ".*办公厅$", ".*委员会$"],
      "features": ["右对齐", "机关名称", "无标点", "字数<30"],
      "examples": ["XX省人民政府", "XX市人民政府办公厅"]
    },
    "成文日期": {
      "position": "发文机关署名之下或同行右侧",
      "patterns": ["\\d{4}年\\d{1,2}月\\d{1,2}日", "\\d{4}\\.\\d{1,2}\\.\\d{1,2}"],
      "features": ["右对齐", "包含年月日", "可能有空格占位"],
      "examples": ["2024年3月15日", "二〇二四年三月十五日"]
    },
    "附注": {
      "position": "成文日期之后",
      "patterns": ["^（.*[:：].*）", "^\\(.*[:：].*\\)", "^附注[:：].*"],
      "features": ["圆括号包裹", "包含联系人、电话等信息", "左空2字"],
      "examples": ["（联系人：张三，电话：010-12345678）", "附注：此件公开发布"]
    },
    "抄送机关": {
      "position": "版记区域",
      "patterns": ["^抄送[:：].*[。.]$"],
      "features": ["以「抄送」开头", "以句号结尾", "顶格"],
      "examples": ["抄送：XX厅、XX局。"]
    }
  },

  "formatSpecification": {
    "发文机关标志": {
      "font": "方正小标宋简体",
      "fontSize": "由机关自定",
      "color": "红色 RGB(192,0,0)",
      "align": "居中",
      "bold": true
    },
    "发文字号": {
      "font": "仿宋_GB2312",
      "fontSize": 16,
      "align": "居中",
      "spacing": "上空1行"
    },
    "标题": {
      "font": "方正小标宋简体",
      "fontSize": 22,
      "align": "居中",
      "bold": true,
      "spacing": "上空1行"
    },
    "主送机关": {
      "font": "仿宋_GB2312",
      "fontSize": 16,
      "align": "左对齐",
      "indent": 0
    },
    "正文": {
      "font": "仿宋_GB2312",
      "fontSize": 16,
      "align": "两端对齐",
      "firstLineIndent": 2,
      "lineSpacing": "固定值28磅"
    },
    "一级标题": {
      "font": "黑体",
      "fontSize": 16,
      "numberingFormat": "一、二、三",
      "bold": false
    },
    "二级标题": {
      "font": "楷体_GB2312",
      "fontSize": 16,
      "numberingFormat": "（一）（二）（三）",
      "bold": false
    },
    "三级标题": {
      "font": "仿宋_GB2312",
      "fontSize": 16,
      "numberingFormat": "1. 2. 3.",
      "bold": true
    },
    "成文日期": {
      "font": "仿宋_GB2312",
      "fontSize": 16,
      "align": "右对齐",
      "spacing": "右空4字"
    }
  },

  "structureGuidance": {
    "title": "【公文结构识别】",
    "order": [
      "发文机关标志(header.org) - 红色醒目",
      "发文字号(header.refno) - 包含年份和编号",
      "签发人(header.signer) - 可选",
      "文件标题(title.main) - 关于...的通知/函/请示",
      "主送机关(title.recipient) - 以冒号结尾",
      "正文(body.normal) - 首行缩进2字符",
      "  ├─ 一级标题(title.1) - 一、二、三",
      "  ├─ 二级标题(title.2) - （一）（二）（三）",
      "  └─ 三级标题(title.3) - 1. 2. 3.",
      "附件说明(body.attachment) - 附件：...",
      "发文机关署名(footer.signature) - 右对齐",
      "成文日期(footer.date) - 右对齐，右空4字",
      "附注(footer.note) - 圆括号，左空2字",
      "抄送机关(footer.cc) - 抄送：...。"
    ],
    "rules": [
      "【核心原则】公文结构是固定的，必须严格按照GB/T 9704-2012标准识别",
      "【发文字号识别】必须包含：年份（4位数字）+编号，格式如「〔2024〕1号」",
      "【标题识别】通常包含「关于」+主题+文种（通知/函/请示/报告/批复）",
      "【主送机关】必须以冒号结尾，可能包含「各」字，顶格不缩进",
      "【正文首段】通常以「经...同意」「根据...」「为...」「现将...」开头",
      "【层级标题】一、（一）、1. 三级体系，不要使用通用heading.*",
      "【附件说明】位于正文之后、成文日期之前，格式「附件：...」或「附件1：...」",
      "【发文机关署名】右对齐，机关全称，无标点",
      "【成文日期】右对齐，右空4字，格式「XXXX年X月X日」",
      "【附注】圆括号包裹，左空2字，包含联系方式",
      "【抄送机关】版记区域，格式「抄送：XX、XX。」以句号结尾",
      "【边界情况】空行、分隔线标为special；如果无法确定，优先标为body.normal"
    ]
  },

  "examples": [
    {
      "paraIndex": 0,
      "text": "XX省人民政府办公厅",
      "tag": "header.org",
      "reason": "文档开头，省级政府机关名称"
    },
    {
      "paraIndex": 1,
      "text": "X政办〔2024〕1号",
      "tag": "header.refno",
      "reason": "包含年份〔2024〕和编号1号"
    },
    {
      "paraIndex": 2,
      "text": "关于印发XX实施方案的通知",
      "tag": "title.main",
      "reason": "以「关于」开头，以文种「通知」结尾"
    },
    {
      "paraIndex": 3,
      "text": "各市、县人民政府：",
      "tag": "title.recipient",
      "reason": "以冒号结尾，包含「各」字，主送机关"
    },
    {
      "paraIndex": 4,
      "text": "经省政府同意，现将《XX实施方案》印发给你们，请认真贯彻执行。",
      "tag": "body.normal",
      "reason": "正文首段，以「经...同意，现将...」开头"
    },
    {
      "paraIndex": 5,
      "text": "一、总体要求",
      "tag": "title.1",
      "reason": "汉字数字开头+顿号，一级标题"
    },
    {
      "paraIndex": 6,
      "text": "（一）指导思想",
      "tag": "title.2",
      "reason": "括号包裹汉字数字，二级标题"
    },
    {
      "paraIndex": 7,
      "text": "1.明确工作目标",
      "tag": "title.3",
      "reason": "阿拉伯数字+点号，三级标题"
    },
    {
      "paraIndex": 8,
      "text": "附件：XX实施方案",
      "tag": "body.attachment",
      "reason": "以「附件：」开头"
    },
    {
      "paraIndex": 9,
      "text": "XX省人民政府办公厅",
      "tag": "footer.signature",
      "reason": "发文机关署名，应右对齐"
    },
    {
      "paraIndex": 10,
      "text": "2024年3月15日",
      "tag": "footer.date",
      "reason": "成文日期格式，应右对齐右空4字"
    },
    {
      "paraIndex": 11,
      "text": "（联系人：张三，电话：010-12345678）",
      "tag": "footer.note",
      "reason": "圆括号包裹联系方式，应左空2字"
    },
    {
      "paraIndex": 12,
      "text": "抄送：XX厅、XX局。",
      "tag": "footer.cc",
      "reason": "以「抄送：」开头，以句号结尾"
    }
  ]
}
