{
  "version": 1,
  "cases": [
    {
      "id": "S-skill-gate",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "DeleteText",
      "allowedTools": ["InsertText"],
      "expectedErrorCode": "TOOL_NOT_ALLOWED",
      "expectedHostCalls": 0
    },
    {
      "id": "S-vba-disabled",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "ExecuteVBA",
      "allowedTools": ["ExecuteVBA"],
      "params": {"code": "Sub Test(): End Sub"},
      "expectedErrorCode": "VBA_DISABLED",
      "expectedHostCalls": 0
    },
    {
      "id": "S-python-compute-controlled",
      "kind": "tool_execution",
      "appType": "Excel",
      "toolId": "PythonCompute",
      "allowedTools": ["PythonCompute"],
      "params": {
        "code": "result = sum(input_data['values'])",
        "input": {"values": [1, 2, 3]}
      },
      "expectedSuccess": true,
      "expectedHostCalls": 0
    },
    {
      "id": "S-host-isolation",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "WriteData",
      "allowedTools": ["WriteData"],
      "expectedErrorCode": "HOST_UNSUPPORTED",
      "expectedHostCalls": 0
    },
    {
      "id": "S-office-operation-requires-discovery",
      "kind": "tool_execution",
      "appType": "Excel",
      "toolId": "OfficeObjectOperation",
      "allowedTools": ["DiscoverOfficeCapability", "OfficeObjectOperation"],
      "params": {
        "batch": {
          "schemaVersion": "1.0",
          "appType": "Excel",
          "atomic": true,
          "operations": []
        }
      },
      "expectedErrorCode": "TOOL_NOT_ALLOWED",
      "expectedRecoverable": true,
      "expectedHostCalls": 0
    },
    {
      "id": "S-office-operation-invalid-schema-repairs",
      "kind": "tool_execution",
      "appType": "Excel",
      "toolId": "OfficeObjectOperation",
      "allowedTools": ["DiscoverOfficeCapability", "OfficeObjectOperation"],
      "successfulPriorTools": ["DiscoverOfficeCapability"],
      "params": {
        "batch": {
          "schemaVersion": "1.0",
          "appType": "Excel",
          "commands": [
            {"command": "CopySheet", "params": {"sourceName": "销售数据"}}
          ]
        }
      },
      "expectedErrorCode": "OPERATION_SCHEMA_INVALID",
      "expectedRecoverable": true,
      "expectedHostCalls": 0
    },
    {
      "id": "S-approval-resume",
      "kind": "tool_execution",
      "appType": "Word",
      "toolId": "DeleteText",
      "allowedTools": ["DeleteText"],
      "approvedTools": ["DeleteText"],
      "params": {"range": "selection"},
      "expectedSuccess": true,
      "expectedHostCalls": 1
    },
