{
  "id": "GenerateReport",
  "name": "生成报表",
  "description": "基于 Excel 数据范围生成分析报表工作表，可包含摘要和图表",
  "appType": "excel",
  "category": "数据操作",
  "riskLevel": "medium",
  "isVbaFallback": false,
  "parameters": [
    {
      "name": "sourceRange",
      "type": "string",
      "required": true,
      "description": "源数据范围，如 A1:F100 或 {selection}"
    },
    {
      "name": "targetSheet",
      "type": "string",
      "required": false,
      "description": "目标报表工作表名称"
    },
    {
      "name": "title",
      "type": "string",
      "required": false,
      "description": "报表标题"
    },
    {
      "name": "includeChart",
      "type": "boolean",
      "required": false,
      "description": "是否同时生成图表"
    }
  ]
}
